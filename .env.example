# Copy this file to .env (never commit .env) and fill it in.

# Jira Cloud access (read only). Create the token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SITE=glana.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Website password. Required when the site is reachable from other computers.
# The browser asks for user "glana" (change with APP_USER) and this password.
APP_PASSWORD=

# PORT=8080
