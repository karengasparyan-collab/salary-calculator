# Copy this file to .env (never commit .env) and fill it in.

# Jira Cloud access (read only). Create the token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SITE=glana.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Website password. Required when the site is reachable from other computers.
# The site shows a sign-in page that asks for this password. Changing it signs everyone out.
# It can later be replaced from Settings → Password; changing APP_PASSWORD here brings this one back.
APP_PASSWORD=
# Optional: an extra long random text used to sign the sign-in cookie. Not needed; APP_PASSWORD alone is enough.
# SESSION_SECRET=

# PORT=8080

# Shared database (on Vercel these are added for you by Storage → Upstash for Redis).
# Without them, `npm start` saves to data/db.json on this computer.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
